# ==============================================================================
# Webicro Distribution - Örnek Ortam Değişkenleri (.env.example)
# ==============================================================================
# Bu dosya, Webicro Distribution için desteklenen tüm ortam değişkenlerini belgeler.
# Gerçek anahtarlarınızı bu dosyaya yazmayın; bu dosyayı '.env' olarak kopyalayın.
# '.env' ve '.release/credentials.json' dosyaları .gitignore tarafından korunmaktadır.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Play Console Dağıtım Kimlik Bilgileri
# ------------------------------------------------------------------------------
# Google Play Developer API için Google Cloud Console üzerinden oluşturulan
# servis hesabı anahtarı. Dosya yolu (önerilen) veya tek satır JSON olarak verilebilir.
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH="./secrets/google-play-service-account.json"
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# ------------------------------------------------------------------------------
# 2. Apple App Store Connect Dağıtım Kimlik Bilgileri
# ------------------------------------------------------------------------------
# App Store Connect API -> Kullanıcılar ve Erişim -> Entegrasyonlar -> API Anahtarları
# 'App Manager' veya 'Admin' yetkisine sahip API anahtarı.
APP_STORE_KEY_ID="XXXXXXXXXX"
APP_STORE_ISSUER_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# AuthKey_XXXXXXXXXX.p8 dosyasının yolu veya içeriği
APP_STORE_PRIVATE_KEY_PATH="./secrets/AuthKey_XXXXXXXXXX.p8"
# APP_STORE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# 3. Yapay Zeka (AI) Motoru & Çok Dilli Sürüm Notu Üreticisi
# ------------------------------------------------------------------------------
# Tercih edilen AI sağlayıcısı: 'gemini' | 'openai' | 'anthropic' | 'conventional'
AI_PROVIDER="gemini"

# Google Gemini API Anahtarı (Önerilen & Yüksek Hızlı Flash Modelleri)
# https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# OpenAI API Anahtarı
# https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Anthropic Claude API Anahtarı
# https://console.anthropic.com/
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# ------------------------------------------------------------------------------
# 4. Bildirim Kanalları & Webhook'lar (Opsiyonel)
# ------------------------------------------------------------------------------
# Dağıtım tamamlandığında veya hata alındığında bildirim gönderilecek URL'ler
SLACK_WEBHOOK_URL=""
DISCORD_WEBHOOK_URL=""

# ------------------------------------------------------------------------------
# 5. Dağıtım ve Ağ Seçenekleri
# ------------------------------------------------------------------------------
# Web Dashboard bağlantı noktası (Varsayılan: 3100)
WEBICRO_UI_PORT="3100"

# Geliştirme log seviyesi: 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL="info"
