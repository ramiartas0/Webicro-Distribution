{
  "name": "@webicro/cli",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "release": "./dist/index.js",
    "webicro": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/copy-web-dist.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@webicro/shared": "workspace:*",
    "@webicro/database": "workspace:*",
    "@webicro/audit": "workspace:*",
    "@webicro/config": "workspace:*",
    "@webicro/git": "workspace:*",
    "@webicro/versioning": "workspace:*",
    "@webicro/ai": "workspace:*",
    "@webicro/validation": "workspace:*",
    "@webicro/flutter": "workspace:*",
    "@webicro/google-play": "workspace:*",
    "@webicro/app-store": "workspace:*",
    "@webicro/core": "workspace:*",
    "commander": "catalog:",
    "@clack/prompts": "catalog:",
    "better-sqlite3": "catalog:",
    "simple-git": "catalog:",
    "ora": "catalog:",
    "chalk": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
